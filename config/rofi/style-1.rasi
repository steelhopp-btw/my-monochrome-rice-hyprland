
configuration {
    modi:                       "drun";
    show-icons:                 false;
    drun-display-format:        "{name}";
}


@import                          "shared/fonts.rasi"

* {
    background:                  #000000CC;
    background-alt:              #111111CC;
    foreground:                  #FFFFFFFF;
    selected:                    #FFFFFFCC;
}


window {
    transparency:                "real"; 
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       400px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     15px;
    border:                      0px solid;
    border-radius:               12px; 
    background-color:            @background;
    cursor:                      "default";
}


mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}


inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     10px 0px;
    border:                      0px 0px 1px 0px solid;
    border-color:                #222222FF;
    background-color:            transparent;
    text-color:                  @foreground;
    children:                    [ "entry" ];
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Поиск...";
    placeholder-color:           #555555FF;
    horizontal-align:            0.5;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     4px;
    margin:                      0px;
    padding:                     5px 0px 0px 0px;
    background-color:            transparent;
}

element {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     8px;
    border-radius:               8px; 
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  #000000FF; 
}

element-icon {
    enabled:                     false;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}


error-message {
    padding:                     15px;
    background-color:            @background;
    text-color:                  @foreground;
}
textbox {
    background-color:            @background;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
